\begin_layout Standard
To get the expression for the chemical potential,
 we use the four-sine result from above with 
\begin_inset Formula $k''\to p'$
\end_inset

:
\begin_inset Formula 
\begin{align*}
\int[\psi^{*}(x)\psi(x)]^{2}\d x & =\int\left(\sum_{p'p}\braket{\psi}{p'}\sqrt{\frac{2}{L}}\sin\frac{\pi p'x}{L}\sqrt{\frac{2}{L}}\sin\frac{\pi px}{L}\braket p{\psi}\right)^{2}\d x\\
 & =\sum_{p'p}\sum_{k'k}\frac{4}{L^{2}}\int\braket{\psi}p\braket{p'}{\psi}\braket{\psi}{k'}\braket k{\psi}\sin\frac{\pi p'x}{L}\sin\frac{\pi px}{L}\sin\frac{\pi k'x}{L}\sin\frac{\pi kx}{L}\d x\\
 & =\frac{1}{2L}\sum_{p'p}\sum_{k'k}\braket{\psi}p\braket{p'}{\psi}\braket{\psi}{k'}\braket k{\psi}(\delta_{k,p}\delta_{k',p'}+\delta_{-k+p+k',p'}-\delta_{k-p-k',p'}-\delta_{-k-p+k',p'}+\delta_{k+p-k',p'})\\
 & =\frac{1}{2L}\sum_{pkk'}\psi_{p}^{*}\psi_{k}\psi_{k'}^{*}(\psi_{-k+p+k'}+\psi_{k-p+k'}-\psi_{k-p-k'}-\psi_{-k+p-k'}-\psi_{-k-p+k'}-\psi_{k+p+k'}+\psi_{k+p-k'})
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection
cos-basis
\end_layout

\begin_layout Standard
Cos basis is very much like sin.
 The starting point is
\begin_inset Formula 
\[
\sum_{x}(\hat{U}^{\dagger})_{px}|\psi_{x}|^{2}\psi_{x}=\frac{4}{L^{2}}\sum_{k,k',k''}\intop\d x\,\cos\frac{\pi px}{L}\cos\frac{\pi kx}{L}\cos\frac{\pi k'x}{L}\cos\frac{\pi k''x}{L}\braket k{\psi}\braket{\psi}{k'}\braket{k''}{\psi}.
\]

\end_inset

However,
 it is important to note that 
\begin_inset Formula $k,k',k'',p$
\end_inset

 run from 
\begin_inset Formula $0$
\end_inset

 to 
\begin_inset Formula $M$
\end_inset

.
 For example,
 all can be 0 and this gives nonzero contribution!
 Except this case,
 can we assume they run from 
\begin_inset Formula $1$
\end_inset

 to 
\begin_inset Formula $M+1$
\end_inset

?
\end_layout

\begin_layout Section
Polar without angular dependence
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $H_{ij}(\boldsymbol{r})$
\end_inset

 do not depend on the polar angle 
\begin_inset Formula $\varphi$
\end_inset

,
 we can reduce the problem to 1D.
 But we consider a more general case:
 let 
\begin_inset Formula $H_{ij}(\boldsymbol{r})=h(\rho)\e^{\i\ell_{ij}\varphi}$
\end_inset

.
 Then,
 we can search for solutions of the form 
\begin_inset Formula $\Psi_{i}^{\lambda}(\rho,\varphi)=f_{i}^{\lambda}(\rho)\e^{\i l_{i}\varphi}$
\end_inset

.
 Let additionally,
 it be possible to find conditions for 
\begin_inset Formula $l_{i}$
\end_inset

's and 
\begin_inset Formula $\ell_{ij}$
\end_inset

 such that all exponents 
\begin_inset Formula $\e^{\i l_{i}\varphi}$
\end_inset

 and 
\begin_inset Formula $\e^{\i\ell_{ij}\varphi}$
\end_inset

 cancel.
 Then,
 the Hamiltonian becomes
\begin_inset Formula 
\[
\hat{H}(\rho,\varphi)=\begin{pmatrix}(-\i\nabla-\boldsymbol{A}(\rho))^{2}+h_{11}(\rho)-\i\Gamma_{1} & h_{12}(\rho)\e^{\i l_{12}\varphi} & \cdots\\
h_{12}(\rho)\e^{-\i l_{12}\varphi} & (-\i\nabla-\boldsymbol{A}(\rho))^{2}+h_{22}(\rho)-\i\Gamma_{2} & \cdots\\
\vdots & \vdots & \ddots
\end{pmatrix}.
\]

\end_inset

Consider two-component case first for simplicity.
 The equation for the first component is:
\begin_inset Formula 
\begin{align*}
\varepsilon_{1}^{\lambda}\Psi_{1}^{\lambda}(\rho,\varphi) & =\{[-\i\nabla-\boldsymbol{A}]^{2}+h_{11}-\i\Gamma_{1}\}\Psi_{1}^{\lambda}+h_{12}(\rho)\e^{\i\ell_{12}\varphi}\Psi_{2}^{\lambda}\\
 & =-\Delta\Psi_{1}^{\lambda}+(\boldsymbol{A}^{2}+\i\nabla\boldsymbol{A}+h_{11}-\i\Gamma_{1})\Psi_{1}^{\lambda}+2\i\boldsymbol{A}\nabla\Psi_{1}^{\lambda}+h_{12}(\rho)\e^{\i\ell_{12}\varphi}\Psi_{2}^{\lambda}\\
 & =-\Delta\Psi_{1}^{\lambda}+(\boldsymbol{A}^{2}+\i\nabla_{\rho}A_{\rho}+h_{11}-\i\Gamma_{1})\Psi_{1}^{\lambda}+2\i\boldsymbol{A}\nabla\Psi_{1}^{\lambda}+h_{12}(\rho)\e^{\i\ell_{12}\varphi}
\end{align*}

\end_inset

Next,
 let 
\begin_inset Formula $\Psi_{i}^{\lambda}(\rho,\varphi)=f_{i}^{\lambda}(\rho)\e^{\i l_{i}\varphi}$
\end_inset

.
 We find:
\begin_inset Formula 
\begin{align*}
\Delta\Psi_{1}^{\lambda} & =\left(\Delta_{\rho}+\frac{1}{\rho^{2}}\frac{\partial^{2}}{\partial\varphi^{2}}\right)\Psi_{1}^{\lambda}=\left(\Delta_{\rho}-\frac{l_{1}^{2}}{\rho^{2}}\right)f_{1}^{\lambda}\e^{\i l_{1}\varphi}\\
\boldsymbol{A}\nabla\Psi_{1}^{\lambda} & =\left(A_{\rho}\nabla_{\rho}+A_{\varphi}\frac{1}{\rho}\frac{\partial}{\partial\varphi}\right)\Psi_{1}^{\lambda}=\left(A_{\rho}\nabla_{\rho}+\i A_{\varphi}\frac{l_{1}}{\rho}\right)f_{1}^{\lambda}\e^{\i l_{1}\varphi}
\end{align*}

\end_inset

Dividing the preceding by 
\begin_inset Formula $\e^{\i l_{1}\varphi}$
\end_inset

,
 we thus get
\begin_inset Formula 
\[
\varepsilon_{1}^{\lambda}f_{1}^{\lambda}(\rho)=-\Delta_{\rho}f_{1}^{\lambda}+(\boldsymbol{A}^{2}+\i\nabla_{\rho}A_{\rho}+\frac{l_{1}^{2}}{\rho^{2}}-2A_{\varphi}\frac{l_{1}}{\rho}+h_{11}-\i\Gamma_{1})f_{1}^{\lambda}+2\i A_{\rho}\nabla_{\rho}f_{1}^{\lambda}+h_{12}f_{2}^{\lambda}\e^{\i(\ell_{12}+l_{2}-l_{1})\varphi}
\]

\end_inset

Thus,
 if 
\begin_inset Formula $\ell_{12}+l_{2}-l_{1}=0$
\end_inset

,
 then a solution whereby 
\begin_inset Formula $f_{1}^{\lambda}$
\end_inset

 indeed does not depend on the angle might exist.
 In the general case with more components,
 there will be a system of conditions for 
\begin_inset Formula $\ell_{ij}$
\end_inset

 and 
\begin_inset Formula $l_{i}$
\end_inset

 that can be simultaneously satisfied.
 The Hamiltonian is then
\begin_inset Formula 
\[
\hat{H}(\rho)=\begin{pmatrix}-\Delta_{\rho}+\boldsymbol{A}^{2}+\i\nabla_{\rho}A_{\rho}+\frac{l_{1}^{2}}{\rho^{2}}-2A_{\varphi}\frac{l_{1}}{\rho}+h_{11}+2\i A_{\rho}\nabla_{\rho}-\i\Gamma_{1} & h_{12} & \cdots\\
h_{12} & -\Delta_{\rho}+\boldsymbol{A}^{2}+\i\nabla_{\rho}A_{\rho}+\frac{l_{2}^{2}}{\rho^{2}}-2A_{\varphi}\frac{l_{2}}{\rho}+h_{22}+2\i A_{\rho}\nabla_{\rho}-\i\Gamma_{2} & \cdots\\
\vdots & \vdots & \ddots
\end{pmatrix}.
\]

\end_inset


\end_layout

