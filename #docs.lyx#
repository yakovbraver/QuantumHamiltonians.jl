\begin_layout Standard
Now consider the sin basis:
\begin_inset Formula 
\begin{align*}
\sum_{x}(\hat{U}^{\dagger})_{px}|\psi_{x}|^{2}\psi_{x} & =\frac{4}{L^{2}}\sum_{k,k',k''}\intop\d x\,\sin\frac{\pi px}{L}\sin\frac{\pi kx}{L}\sin\frac{\pi k'x}{L}\sin\frac{\pi k''x}{L}\braket k{\psi}\braket{\psi}{k'}\braket{k''}{\psi}
\end{align*}

\end_inset

where 
\begin_inset Formula $k,k'',p,p''$
\end_inset

 run from 
\begin_inset Formula $1$
\end_inset

 to 
\begin_inset Formula $M$
\end_inset

.
\end_layout

\begin_layout Standard
We know that
\begin_inset Formula 
\begin{align*}
\frac{4}{L^{2}}\intop\d x\,\sin\frac{\pi kx}{L}\sin\frac{\pi px}{L}\sin\frac{\pi k'x}{L}\sin\frac{\pi k''x}{L} & =\frac{1}{L^{2}}\intop_{0}^{L}\cos\frac{\pi(k-p)x}{L}\cos\frac{\pi(k'-k'')x}{L}\d x\\
 & -\frac{1}{L^{2}}\intop_{0}^{L}\cos\frac{\pi(k-p)x}{L}\cos\frac{\pi(k'+k'')x}{L}\d x\\
 & -\frac{1}{L^{2}}\intop_{0}^{L}\cos\frac{\pi(k+p)x}{L}\cos\frac{\pi(k'-k'')x}{L}\d x\\
 & +\frac{1}{L^{2}}\intop_{0}^{L}\cos\frac{\pi(k+p)x}{L}\cos\frac{\pi(k'+k'')x}{L}\d x
\end{align*}

\end_inset

Using the formula
\begin_inset Formula 
\[
\intop_{0}^{L}\cos\frac{\pi mx}{L}\cos\frac{\pi nx}{L}\d x=\frac{L}{2}(\delta_{m,n}+\delta_{m,-n})
\]

\end_inset

we find
\begin_inset Formula 
\begin{align*}
= & \frac{1}{2L}(\delta_{k-p,k'-k''}+\delta_{k-p,k''-k'}-\delta_{k-p,k'+k''}-\delta_{k-p,-k'-k''}-\delta_{k+p,k'-k''}-\delta_{k+p,k''-k'}+\delta_{k+p,k'+k''}+\cancel{\delta_{k+p,-k'-k''}}).\\
= & \frac{1}{2L}(\delta_{-k+p+k',k''}+\delta_{k-p+k',k''}-\delta_{k-p-k',k''}-\delta_{-k+p-k',k''}-\delta_{-k-p+k',k''}-\delta_{k+p+k',k''}+\delta_{k+p-k',k''}).
\end{align*}

\end_inset

The stroked out last cannot be satisfied because 
\begin_inset Formula $k+p$
\end_inset

 is positive.
 Then we have
\begin_inset Formula 
\begin{align*}
\sum_{x}(\hat{U}^{\dagger})_{px}|\psi_{x}|^{2}\psi_{x} & =\frac{1}{2L}\sum_{k,k',k''}(\delta_{-k+p+k',k''}+\delta_{k-p+k',k''}-\delta_{k-p-k',k''}-\delta_{-k+p-k',k''}-\delta_{-k-p+k',k''}-\delta_{k+p+k',k''}+\delta_{k+p-k',k''})\braket k{\psi}\braket{\psi}{k'}\braket{k''}{\psi}\\
 & =\frac{1}{2L}\sum_{k,k'}(\braket{-k+p+k'}{\psi}+\braket{k-p+k'}{\psi}-\braket{k-p-k'}{\psi}-\braket{-k+p-k'}{\psi}-\braket{-k-p+k'}{\psi}-\braket{k+p+k'}{\psi}+\braket{k+p-k'}{\psi})\braket k{\psi}\braket{\psi}{k'}\\
 & =\frac{1}{2L}\sum_{k,k'}\psi_{k}\psi_{k'}^{*}(\psi_{-k+p+k'}+\psi_{k-p+k'}-\psi_{k-p-k'}-\psi_{-k+p-k'}-\psi_{-k-p+k'}-\psi_{k+p+k'}+\psi_{k+p-k'})
\end{align*}

\end_inset


\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
In the code,
 the sum is
\begin_inset Formula 
\[
\sum_{k=1}^{B}\psi_{k}\left(\sum_{k'=\max(1,1+k-p)}^{\min(B,B+k-p)}\psi_{k'}\psi_{k'-k+p}-\sum_{k'=\max(1,-1+k-p)}^{\min(B,B+p-k)}\psi_{k'}\psi_{-k'+k-p}-\sum_{k'=\max(1,1+p+k)}^{\min(B,B+p-k)}\psi_{k'}\psi_{k'-k-p}+\sum_{k'=\max(1,-1+k+p)}^{\min(B,B+p-k)}\psi_{k'}\psi_{-k'+k+p}\right)
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
The full equation is
\begin_inset Formula 
\[
\psi_{p}^{\prime}=-\i\sum_{p'}\hat{H}_{pp'}\psi_{p'}-\i\frac{g}{2L}\sum_{k,k'}\psi_{k}\psi_{k'}^{*}(\psi_{-k+p+k'}+\psi_{k-p+k'}-\psi_{k-p-k'}-\psi_{-k+p-k'}-\psi_{-k-p+k'}-\psi_{k+p+k'}+\psi_{k+p-k'}).
\]

\end_inset


\end_layout

\begin_layout Paragraph
