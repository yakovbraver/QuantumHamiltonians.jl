\begin_inset Formula 
\begin{equation}
\bra{\psi_{m'}}\hat{x}\ket{\psi_{m}}=\sum_{j,j'}\frac{2}{L_{x}}\int_{0}^{L_{x}}\d x\,c_{j'}^{(m')}\sin\left(\frac{\pi j'x}{L_{x}}\right)xc_{j}^{(m)}\sin\left(\frac{\pi jx}{L_{x}}\right)\label{eq:space-periodic-wanniers}
\end{equation}

\end_inset

We have
\begin_inset Formula 
\begin{align*}
\frac{2}{L_{x}}\int_{0}^{L_{x}}\d x\,\sin\left(\frac{\pi j'x}{L_{x}}\right)x\sin\left(\frac{\pi jx}{L_{x}}\right)= & \frac{4[(-1)^{j+j'}-1]jj'L_{x}}{\pi^{2}(j^{2}-j'^{2})^{2}}+\frac{L_{x}}{2}\delta_{j,j'}=-\frac{8L_{x}}{\pi^{2}}\frac{jj'}{(j^{2}-j'^{2})^{2}}\delta_{(j+j')\bmod2,1}+\frac{L_{x}}{2}\delta_{j,j'}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
Check:
 (
\begin_inset Formula $j,j',s,N\in\mathbb{Z}$
\end_inset

)
\begin_inset Formula 
\[
I_{j',j}=\frac{2}{N\pi}\intop_{0}^{N\pi}\sin\left(\frac{j'}{N}x\right)x\sin\left(\frac{j}{N}x\right)\d x=\frac{2}{N\pi}\intop_{0}^{N\pi}\frac{1}{2}\left[x\cos\left(\frac{j'-j}{N}x\right)-x\cos\left(\frac{j'+j}{N}x\right)\right]\d x
\]

\end_inset


\begin_inset Formula 
\begin{align*}
A & =\intop_{0}^{N\pi}x\cos\left(\frac{a}{N}x\right)\d x=\frac{N^{2}}{a^{2}}\intop_{0}^{a\pi}y\cos\left(y\right)\d y=\frac{N^{2}}{a^{2}}\left(y\sin y|_{0}^{a\pi}-\intop_{0}^{a\pi}\sin(y)\d y\right)=\frac{N^{2}}{a^{2}}\left(\pi\sin a\pi+\cos a\pi-1\right)\\
 & =\frac{N^{2}}{a^{2}}[(-1)^{a}-1]
\end{align*}

\end_inset


\begin_inset Formula 
\[
A=\intop_{0}^{N\pi}x\,\d x=\frac{(N\pi)^{2}}{2}
\]

\end_inset

so that
\begin_inset Formula 
\[
A=\frac{N^{2}}{a^{2}}[(-1)^{a}-1]+\frac{(N\pi)^{2}}{2}\delta_{a,0}
\]

\end_inset

and
\begin_inset Formula 
\begin{align*}
I_{j',j} & =\frac{2}{N\pi}\frac{1}{2}\left[\frac{N^{2}}{(j'-j)^{2}}[(-1)^{j'-j}-1]+\frac{(N\pi)^{2}}{2}\delta_{j'-j,0}-\left(\frac{N^{2}}{(j'+j)^{2}}[(-1)^{j'+j}-1]+\frac{(N\pi)^{2}}{2}\delta_{j'+j,0}\right)\right]\\
 & =\frac{1}{N\pi}\left[\left(\frac{N^{2}}{(j'-j)^{2}}-\frac{N^{2}}{(j'+j)^{2}}\right)[(-1)^{j'-j}-1]+\frac{(N\pi)^{2}}{2}\delta_{j'-j,0}-\frac{(N\pi)^{2}}{2}\delta_{j'+j,0}\right]\\
 & =\frac{4j'jN[(-1)^{j'-j}-1]}{\pi(j'-j)^{2}(j'+j)^{2}}+\frac{N\pi}{2}\delta_{j'-j,0}-\frac{N\pi}{2}\delta_{j'+j,0}
\end{align*}

\end_inset


\end_layout

\end_inset

Thus,
\begin_inset Formula 
\begin{align*}
\bra{\psi_{m'}}\hat{x}\ket{\psi_{m}} & =\sum_{j,j'}c_{j'}^{(m')}c_{j}^{(m)}\left(\frac{L_{x}}{2}\delta_{j,j'}-\frac{8L_{x}}{\pi^{2}}\frac{jj'}{(j^{2}-j'^{2})^{2}}\delta_{(j+j')\bmod2,1}\right)\\
 & =\frac{L_{x}}{2}\delta_{m,m'}-\frac{8L_{x}}{\pi^{2}}\sum_{j=1}^{\infty}c_{j}^{(m)}\sum_{j'\in(\text{odd}(j)?\text{evens}:\text{odds})}c_{j'}^{(m')}\frac{jj'}{(j^{2}-j'^{2})^{2}}
\end{align*}

\end_inset

where we used 
\begin_inset Formula $\sum_{j,j'}c_{j'}^{(m')}c_{j}^{(m)}\delta_{j,j'}=\sum_{j}c_{j}^{(m')}c_{j}^{(m)}=\braket{m'}m=\delta_{m,m'}$
\end_inset

.
\end_layout

\begin_layout Standard
This calculation uses the basis that assumes that 
\begin_inset Formula $x\in[0,L_{x}]$
\end_inset

,
 so the eigenvalues will be 
\begin_inset Formula $\in[0,L_{x}]$
\end_inset

.
 However,
 in practice we have 
\begin_inset Formula $x\in[x_{0},x_{0}+L_{x}]$
\end_inset

.
 Therefore,
 we have to add 
\begin_inset Formula $x_{0}$
\end_inset

 to the eigenvalues.
 Even more conveniently,
 we add 
\begin_inset Formula $x_{0}$
\end_inset

 to the diagonal of 
\begin_inset Formula $\hat{x}$
\end_inset

,
 therefore using 
\begin_inset Formula $(\frac{L_{x}}{2}+x_{0})\delta_{m,m'}$
\end_inset


\end_layout

\begin_layout Subsubsection
2D
\end_layout

\begin_layout Standard
We take the sine basis 
\begin_inset Formula 
\[
\psi_{j_{x}j_{y}}(\boldsymbol{r})=\frac{2}{\sqrt{L_{x}L_{y}}}\sin\frac{\pi j_{x}x}{L_{x}}\sin\frac{\pi j_{y}y}{L_{y}},\qquad j_{x},j_{y}=1,2,\ldots,M.
\]

\end_inset

Note that 
\begin_inset Formula $j_{x},j_{y}=0$
\end_inset

 are not included because it makes no sense to include functions 
\begin_inset Formula $\psi(\boldsymbol{r})=0$
\end_inset

 in the basis.
\end_layout

\begin_layout Standard
The Laplace term is
\begin_inset Formula 
\[
\bra{j_{x}^{\prime}j_{y}^{\prime}}\Delta\ket{j_{x}j_{y}}=-\pi^{2}\left(\frac{j_{x}^{2}}{L_{x}^{2}}+\frac{j_{y}^{2}}{L_{y}^{2}}\right)\delta_{j_{x}^{\prime},j_{x}}\delta_{j_{y}^{\prime},j_{y}}
\]

\end_inset

(If we include 
\begin_inset Formula $j_{x},j_{y}=0$
\end_inset

,
 we will be getting numerous nonzero eigenvalues (e.g.
 
\begin_inset Formula $\pi^{2}\frac{j_{y}^{2}}{L_{y}^{2}}$
\end_inset

 for 
\begin_inset Formula $j_{y}=1,2,\ldots$
\end_inset

) which correspond to eigenfunctions that are everywhere zero.
 We don't want that.)
\end_layout

\begin_layout Standard
Next,
\begin_inset Formula 
\begin{align*}
\bra{j_{x}^{\prime}j_{y}^{\prime}}U_{D}(\boldsymbol{r})\ket{j_{x}j_{y}} & =\frac{4}{L_{x}L_{y}}\iintop_{0}^{L}\sin\frac{\pi j_{x}^{\prime}x}{L}\sin\frac{\pi j_{y}^{\prime}y}{L}U(\boldsymbol{r})\sin\frac{\pi j_{x}x}{L}\sin\frac{\pi j_{y}y}{L}\d x\d y\\
 & =\frac{1}{L_{x}L_{y}}\iintop_{0}^{L}\left(\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L}-\cos\frac{\pi(j_{x}^{\prime}+j_{x})x}{L}\right)U(\boldsymbol{r})\left(\cos\frac{\pi(j_{y}^{\prime}-j_{y})y}{L}-\cos\frac{\pi(j_{y}^{\prime}+j_{y})y}{L}\right)\d x\d y\\
 & =\frac{1}{L_{x}L_{y}}\iintop_{0}^{L}\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L}U(\boldsymbol{r})\cos\frac{\pi(j_{y}^{\prime}-j_{y})y}{L}\d x\d y\\
 & -\frac{1}{L_{x}L_{y}}\iintop_{0}^{L}\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L}U(\boldsymbol{r})\cos\frac{\pi(j_{y}^{\prime}+j_{y})y}{L}\d x\d y\\
 & -\frac{1}{L_{x}L_{y}}\iintop_{0}^{L}\cos\frac{\pi(j_{x}^{\prime}+j_{x})x}{L}U(\boldsymbol{r})\cos\frac{\pi(j_{y}^{\prime}-j_{y})y}{L}\d x\d y\\
 & +\frac{1}{L_{x}L_{y}}\iintop_{0}^{L}\cos\frac{\pi(j_{x}^{\prime}+j_{x})x}{L}U(\boldsymbol{r})\cos\frac{\pi(j_{y}^{\prime}+j_{y})y}{L}\d x\d y
\end{align*}

\end_inset

The integral 
\begin_inset Formula 
\[
\frac{1}{L_{x}L_{y}}\iintop_{0}^{L}\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L}U(\boldsymbol{r})\cos\frac{\pi(j_{y}^{\prime}-j_{y})y}{L}\d x\d y
\]

\end_inset

is the transform term 
\begin_inset Formula $U_{m_{x}m_{y}}$
\end_inset

(times 
\begin_inset Formula $\frac{\d x\d y}{4L_{x}L_{y}}$
\end_inset

,
 with 4 cancelling the 2 included in FFTW for each dimension) with 
\begin_inset Formula $m_{x}=j_{x}^{\prime}-j_{x}$
\end_inset

,
 
\begin_inset Formula $m_{y}=j_{y}^{\prime}-j_{y}$
\end_inset

.
 
\series bold
The value of precisely this integral is stored in 
\family typewriter
buff
\family default
 (in the 
\family typewriter
target_rank=2
\family default
 case).
\end_layout

\begin_layout Standard
Recall that 
\begin_inset Formula $j_{x},j_{y}$
\end_inset

 run from 
\begin_inset Formula $1$
\end_inset

 to 
\begin_inset Formula $M$
\end_inset

.
 Then,
 because of the terms with sums 
\begin_inset Formula $j_{x}^{\prime}+j_{x}$
\end_inset

,
 we will need to calculate harmonics of 
\begin_inset Formula $U$
\end_inset

 up to 
\begin_inset Formula $2M$
\end_inset

.
 But the transform will also include the zeroth harmonic,
 so the number of harmonics to calculate (and the number of points to use for discretising space) is 
\begin_inset Formula 
\[
N=2M+1.
\]

\end_inset

(It is recommended to take transform with the number of points 
\begin_inset Formula $2^{n}-1$
\end_inset

 for some 
\begin_inset Formula $n$
\end_inset

,
 leading to 
\begin_inset Formula $2M+1=2^{n}-1\implies M=2^{n-1}-1$
\end_inset

.
 So 
\begin_inset Formula $M$
\end_inset

 given by power of two minus one is recommend,
 but this is not that important because we do not use so many points for the speed of FFT to matter).
\end_layout

\begin_layout Standard
Next,
 note that we have terms with differences 
\begin_inset Formula $j_{x}^{\prime}-j_{x}$
\end_inset

 but 
\begin_inset Formula $\cos(j_{x}^{\prime}-j_{x})=\cos(j_{x}-j_{x}^{\prime})$
\end_inset

 so we should use 
\begin_inset Formula $m_{x}=|j_{x}^{\prime}-j_{x}|$
\end_inset

,
 
\begin_inset Formula $m_{y}=|j_{y}^{\prime}-j_{y}|$
\end_inset

.
\end_layout

\begin_layout Standard
The derivative term is
\begin_inset Formula 
\begin{align*}
\bra{j_{x}^{\prime}j_{y}^{\prime}}\partial_{x}\ket{j_{x}j_{y}} & =\frac{4}{L_{x}L_{y}}\iintop_{0}^{L}\sin\frac{\pi j_{x}^{\prime}x}{L_{x}}\sin\frac{\pi j_{y}^{\prime}y}{L_{y}}\partial_{x}\sin\frac{\pi j_{x}x}{L_{x}}\sin\frac{\pi j_{y}y}{L_{y}}\d x\d y\\
 & =\frac{2}{L_{x}}\delta_{j_{y}^{\prime},j_{y}}\frac{\pi j_{x}}{L_{x}}\intop_{0}^{L_{x}}\sin\frac{\pi j_{x}^{\prime}x}{L_{x}}\cos\frac{\pi j_{x}x}{L_{x}}\d x\\
 & =\frac{2}{L_{x}}\delta_{j_{y}^{\prime},j_{y}}\frac{\pi j_{x}}{L_{x}}\intop_{0}^{L_{x}}\frac{1}{2}\left(\sin\frac{\pi(j_{x}^{\prime}+j_{x})x}{L_{x}}+\sin\frac{\pi(j_{x}^{\prime}-j_{x})x}{L_{x}}\right)\d x\\
 & =\delta_{j_{y}^{\prime},j_{y}}\frac{\pi j_{x}}{L_{x}^{2}}\left(\frac{L_{x}}{\pi(j_{x}^{\prime}+j_{x})}2\delta_{j_{x}^{\prime}+j_{x},{\rm odd}}+\frac{L_{x}}{\pi(j_{x}^{\prime}-j_{x})}2\delta_{j_{x}^{\prime}-j_{x},{\rm odd}}\right)\\
 & =\delta_{j_{y}^{\prime},j_{y}}\delta_{j_{x}^{\prime}-j_{x},{\rm odd}}\frac{2j_{x}}{L_{x}}\left(\frac{1}{j_{x}^{\prime}+j_{x}}+\frac{1}{j_{x}^{\prime}-j_{x}}\right)\\
 & =\delta_{j_{y}^{\prime},j_{y}}\delta_{j_{x}^{\prime}-j_{x},{\rm odd}}\frac{4}{L_{x}}\frac{j_{x}^{\prime}j_{x}}{j_{x}^{\prime2}-j_{x}^{2}}
\end{align*}

\end_inset


\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
\begin_inset Formula 
\[
\intop_{0}^{L_{x}}\sin\frac{\pi(j_{x}^{\prime}+j_{x})x}{L_{x}}\d x=-\frac{L_{x}}{\pi(j_{x}^{\prime}+j_{x})}[\cos\pi(j_{x}^{\prime}+j_{x})-1]
\]

\end_inset


\end_layout

\end_inset

The second term in brackets has to be included only for 
\begin_inset Formula $j_{x}^{\prime}-j_{x}\neq0$
\end_inset

 (otherwise sin is zero in the first place).
 However,
 the condition that 
\begin_inset Formula $j_{x}^{\prime}-j_{x}$
\end_inset

 is odd automatically means that 
\begin_inset Formula $j_{x}^{\prime}-j_{x}\neq0$
\end_inset

.
\end_layout

\begin_layout Standard
Note that the first derivative matrix squared does not give the correct Laplace.
 Even in 1D,
 
\begin_inset Formula $\bra{j_{x}^{\prime}}\partial_{x}\ket{j_{x}}$
\end_inset

 squared does not coincide with 
\begin_inset Formula $\bra{j_{x}^{\prime}j_{y}^{\prime}}\partial_{x}^{2}\ket{j_{x}j_{y}}$
\end_inset

;
 this is already seen from the fact that Laplace features 
\begin_inset Formula $\pi^{2}$
\end_inset

 while 
\begin_inset Formula $\partial_{x}$
\end_inset

 does not feature 
\begin_inset Formula $\pi$
\end_inset

.
 The matrix 
\begin_inset Formula $\bra{j_{x}^{\prime}}\partial_{x}\ket{j_{x}}$
\end_inset

 squared is is not diagonal.
 For this reason,
 numerical calculation according to 
\begin_inset Formula $(-\i\delta\nabla-\boldsymbol{A})^{2}$
\end_inset

 is not as accurate (in fact,
 turns out to be much less accurate) than the expanded form 
\begin_inset Formula 
\[
-\Delta+\i(A_{x}\partial_{x}+A_{y}\partial_{y}+\partial_{x}A_{x}+\partial_{y}A_{y})+A_{x}^{2}+A_{y}^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
In all of the above,
 we assumed that the interval of interest is 
\begin_inset Formula $x\in[0,L_{x}]$
\end_inset

,
 
\begin_inset Formula $y\in[0,L_{y}]$
\end_inset

,
 with the wf indeed being zero at the edges.
 In general,
 the interval of interest is some 
\begin_inset Formula $x\in[x_{0},x_{0}+L_{x}]$
\end_inset

,
 
\begin_inset Formula $y\in[y_{0},y_{0}+L_{y}]$
\end_inset

.
 The basis functions are then
\begin_inset Formula 
\begin{align*}
\psi_{j_{x}j_{y}}(\boldsymbol{r}) & =\frac{2}{\sqrt{L_{x}L_{y}}}\sin\frac{\pi j_{x}(x-x_{0})}{L_{x}}\sin\frac{\pi j_{y}(y-y_{0})}{L_{y}},\qquad j_{x},j_{y}=1,2,\ldots,M,\\
 & x\in[x_{0},x_{0}+L_{x}],y\in[y_{0},y_{0}+L_{x}]
\end{align*}

\end_inset

Thus,
 in 
\family typewriter
make_eigenfunction
\family default
,
 
\begin_inset Formula $x$
\end_inset

 runs over 
\begin_inset Formula $[x_{0},x_{0}+L_{x}]$
\end_inset

,
 meaning the argument of sin,
 
\begin_inset Formula $x-x_{0}$
\end_inset

,
 runs over 
\begin_inset Formula $[0,L_{x}]$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
\begin_inset Formula 
\[
\intop_{0}^{L_{x}}\sin\frac{\pi(j_{x}^{\prime}+j_{x})x}{L_{x}}\d x=-\frac{L_{x}}{\pi(j_{x}^{\prime}+j_{x})}[\cos\pi(j_{x}^{\prime}+j_{x})-1]=\frac{L_{x}}{\pi(j_{x}^{\prime}+j_{x})}2\delta_{j_{x}^{\prime}+j_{x}\,{\rm odd}}
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsection
cos basis
\end_layout

\begin_layout Subsubsection
1D
\end_layout

\begin_layout Standard
We take the cosine basis 
\begin_inset Formula 
\[
f_{j}(x)\coloneqq\braket x{j_{x}}=\sqrt{\frac{2}{\zeta_{j_{x}}L_{x}}}\cos\frac{\pi j_{x}x}{L_{x}},\qquad j_{x}=0,1,2,\ldots,M.
\]

\end_inset

Note that the functions for 
\begin_inset Formula $j_{x}=0$
\end_inset

 and 
\begin_inset Formula $j_{x}=M$
\end_inset

 are different and nonzero,
 so both are included in the basis.
 Also,
 for 
\begin_inset Formula $j_{x}=0$
\end_inset

 the normalisation factor is 
\begin_inset Formula $\frac{1}{\sqrt{L_{x}}}$
\end_inset

,
 so we include a factor
\begin_inset Formula 
\[
\zeta_{j_{x}}=\begin{cases}
2, & j_{x}=0\\
1, & \text{otherwise}
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Paragraph

\family typewriter
fft_to_matrix
\end_layout

\begin_layout Standard
The Laplace term is
\begin_inset Formula 
\[
\bra{j_{x}^{\prime}}\Delta\ket{j_{x}}=-\left(\frac{\pi j_{x}}{L_{x}}\right)^{2}\delta_{j_{x}^{\prime},j_{x}}
\]

\end_inset

Next,
\begin_inset Formula 
\begin{align*}
\bra{j_{x}^{\prime}}V\ket{j_{x}} & =\frac{2}{\sqrt{\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}}L_{x}}\intop_{0}^{L}\cos\frac{\pi j_{x}^{\prime}x}{L_{x}}V(x)\cos\frac{\pi j_{x}x}{L_{x}}\d x\\
 & =\frac{1}{\sqrt{\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}}L_{x}}\intop_{0}^{L}V(x)\left(\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L_{x}}+\cos\frac{\pi(j_{x}^{\prime}+j_{x})x}{L_{x}}\right)\d x\\
 & =\frac{1}{\sqrt{\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}}L_{x}}\intop_{0}^{L}V(x)\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L_{x}}\d x\\
 & +\frac{1}{\sqrt{\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}}L_{x}}\intop_{0}^{L}V(x)\cos\frac{\pi(j_{x}^{\prime}+j_{x})x}{L_{x}}\d x
\end{align*}

\end_inset

This differs from the sin case only in the sign of the second integral (and the factor 
\begin_inset Formula $\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}$
\end_inset

).
 So again
\begin_inset Formula 
\[
\frac{1}{L_{x}}\intop_{0}^{L}V(\boldsymbol{r})\cos\frac{\pi(j_{x}^{\prime}-j_{x})x}{L_{x}}\d x
\]

\end_inset

is the cos-transform term 
\begin_inset Formula $V_{m}$
\end_inset

 (times 
\begin_inset Formula $\frac{\d x}{2L_{x}}$
\end_inset

,
 with 
\begin_inset Formula $2$
\end_inset

 cancelling the one in FFTW) with 
\begin_inset Formula $m_{x}=j_{x}^{\prime}-j_{x}$
\end_inset

.
 
\series bold
The value of precisely this integral is stored in 
\family typewriter
buff
\family default
 (in the 
\family typewriter
target_rank=2
\family default
 case).
 
\series default
Note:
\end_layout

\begin_layout Itemize
FFTW yields the correct value even for 
\begin_inset Formula $j_{x}^{\prime}-j_{x}=0$
\end_inset

 (i.e.
 there is no division by 2 for the zeroth harmonic or anything like that in FFTW)
\end_layout

\begin_layout Itemize
This integral does not include the factor 
\begin_inset Formula $\frac{1}{\sqrt{\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}}}$
\end_inset

 because FFTW yields some 
\begin_inset Formula $V_{m}$
\end_inset

 with 
\begin_inset Formula $m=j_{x}^{\prime}-j_{x}$
\end_inset

;
 the value of 
\begin_inset Formula $m$
\end_inset

 alone does not determine both 
\begin_inset Formula $j$
\end_inset

's.
 Therefore,
 the factor 
\begin_inset Formula $\frac{1}{\sqrt{\zeta_{j_{x}^{\prime}}\zeta_{j_{x}}}}$
\end_inset

 can only be included when constructing the matrix.
\end_layout

\begin_layout Standard
However,
 now 
\begin_inset Formula $j_{x}$
\end_inset

 runs from 
\begin_inset Formula $0$
\end_inset

 to 
\begin_inset Formula $M$
\end_inset

.
 Because of the term with sums 
\begin_inset Formula $j_{x}^{\prime}+j_{x}$
\end_inset

,
 we will need to calculate harmonics of 
\begin_inset Formula $U$
\end_inset

 up to 
\begin_inset Formula $2M$
\end_inset

.
 But the transform will also include the zeroth harmonic,
 so the number of harmonics to calculate (and the number of points to use for discretising space) is again
\begin_inset Formula 
\[
N=2M+1.
\]

\end_inset


\end_layout

\begin_layout Standard
Next,
 note that we have terms with differences 
\begin_inset Formula $j_{x}^{\prime}-j_{x}$
\end_inset

 but 
\begin_inset Formula $\cos(j_{x}^{\prime}-j_{x})=\cos(j_{x}-j_{x}^{\prime})$
\end_inset

 so we should use 
\begin_inset Formula $m_{x}=|j_{x}^{\prime}-j_{x}|$
\end_inset

.
\end_layout

